<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Minimal-API/health-check surface only (IEndpointRouteBuilder, IHostedService, etc.); this
         library deliberately never references ACE.Server or ACE.Database (ARCH-003/ARCH-004: the
         companion services are their own Cloud Transaction Authority with no live ACE world-object
         coupling). A plain class library can reference the ASP.NET Core shared framework directly
         without adopting Microsoft.NET.Sdk.Web, which is reserved for the runnable host projects. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ACE.Cloud.Domain\ACE.Cloud.Domain.csproj" />
    <ProjectReference Include="..\ACE.Cloud.Contracts\ACE.Cloud.Contracts.csproj" />
    <ProjectReference Include="..\ACE.Cloud.Persistence\ACE.Cloud.Persistence.csproj" />
  </ItemGroup>

</Project>
