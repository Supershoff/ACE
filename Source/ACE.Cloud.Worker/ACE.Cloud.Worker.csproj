<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- ARCH-003/ARCH-004/ARCH-007: the background worker (Custody Outbox consumption, read-model
         rebuilds) references only pure shared contracts, the Cloud domain, and the restricted Cloud
         persistence gateway, never ACE.Server or ACE.Database. -->
    <ProjectReference Include="..\ACE.Cloud.Domain\ACE.Cloud.Domain.csproj" />
    <ProjectReference Include="..\ACE.Cloud.Contracts\ACE.Cloud.Contracts.csproj" />
    <ProjectReference Include="..\ACE.Cloud.Persistence\ACE.Cloud.Persistence.csproj" />
    <ProjectReference Include="..\ACE.Cloud.Hosting\ACE.Cloud.Hosting.csproj" />
    <!-- ASSET-002/ASSET-004: ACE.DatLoader is a standalone client-file parser, not ACE.Server or
         ACE.Database, so referencing it here for background DAT extraction does not cross the
         "never depend on live ACE world objects" boundary the other project references guard. -->
    <ProjectReference Include="..\ACE.DatLoader\ACE.DatLoader.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
